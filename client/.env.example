# AUREX MEET - client configuration
# Copy to `.env` (or `.env.local`). Vite only exposes variables prefixed with
# `VITE_` to the browser bundle. Never put secrets in this file - everything
# here is public by definition.

# Signaling server WebSocket URL.
# Leave empty to use the same origin the page is served from (works with the
# dev proxy in `vite.config.js` and with the production build served by the
# signaling server itself).
# Examples:
#   VITE_SIGNALING_URL=ws://localhost:4000/ws
#   VITE_SIGNALING_URL=wss://meet.example.com/ws
VITE_SIGNALING_URL=

# Base URL used when building shareable meeting links. Leave empty to use
# window.location.origin (correct for localhost and for self-hosting).
VITE_PUBLIC_ORIGIN=

# Dev-only: log protocol traffic to the browser console.
VITE_DEBUG=false
