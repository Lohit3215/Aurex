# AUREX MEET - signaling server configuration
# Copy this file to `.env` and adjust as needed. Every value below is optional;
# the defaults shown are what the server uses when the variable is absent.

# --- HTTP / WS ---------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# error | warn | info | debug
LOG_LEVEL=info

# Comma separated list of origins allowed to call the HTTP API in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- WebSocket path (client derives this too) --------------------------------
WS_PATH=/ws

# --- Limits & safety ---------------------------------------------------------
# Maximum accepted WebSocket frame payload in bytes.
MAX_MESSAGE_BYTES=32768
# WebSocket heartbeat interval; dead connections are reaped after 2 missed beats.
HEARTBEAT_INTERVAL_MS=30000
# Live websocket connections allowed from a single IP address.
MAX_CONNECTIONS_PER_IP=64
# Generic per-connection message budget (all message types combined).
RATE_LIMIT_MAX_MESSAGES=400
# Chat specific per-connection budget.
RATE_LIMIT_CHAT_MAX=40

# --- Meeting rules -----------------------------------------------------------
MAX_NAME_LENGTH=48
MIN_NAME_LENGTH=2
ROOM_ID_LENGTH=12
CHAT_MAX_LENGTH=2000
# How long a disconnected participant may resume its identity after a refresh
# or a short network drop.
RESUME_TTL_MS=90000
# How long an empty room is kept in memory so a quick rejoin still works.
ROOM_TTL_MS=60000

# --- Static client (production) ----------------------------------------------
# When `true` and `client/dist` exists, the server also serves the built SPA.
SERVE_CLIENT=true
